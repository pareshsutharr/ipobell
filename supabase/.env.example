# Edge Function secrets — set with:  supabase secrets set --env-file supabase/.env --project-ref ehpjxstddpkxijfjelax
IPO_API_BASE_URL=https://beipoready.com/api/ipo-data
# Be IPO Ready connector key for the website's IPO data mirror (scope ipo:read). NOT an IPO Guru key.
IPO_API_KEY=bpr_xxx
# Firebase service account JSON (single line). Firebase console → Project settings → Service accounts → Generate new private key
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"ipobell",...}
# Random string; the same value is stored in Supabase Vault as `cron_secret` so pg_cron can call the functions
CRON_SECRET=change-me-to-a-long-random-string
# Google Play service account JSON with "View financial data" + "Manage orders" on the Play Console (for subscription verification)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
ANDROID_PACKAGE_NAME=in.ipobell.app
# GMP change (in ₹ per share, percentage points of cap price) that triggers an alert for watchlisted IPOs
GMP_ALERT_THRESHOLD_PCT=2
# Lead e-mail notifications (notify-lead). Any SMTP account works; GoDaddy example:
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@beipoready.com
SMTP_PASSWORD=change-me
SMTP_FROM=admin@beipoready.com
SMTP_REPLY_TO=admin@beipoready.com
# Fallback recipient when app_settings.lead_notifications has no e-mails
LEAD_NOTIFY_DEFAULT_EMAIL=beipoready@gmail.com
ADMIN_PANEL_URL=https://beipoready-admin.vercel.app

# ask-drhp (Ask-the-DRHP chat). Required for the chat to answer; optional model and daily limit per user.
GEMINI_API_KEY=
GEMINI_MODEL=
DRHP_CHAT_DAILY_LIMIT=
