# Admin panel environment. Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; set it in Vercel, not in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Used by the "draft with AI" button in the insight editor.
GEMINI_API_KEY=
# Optional. Overrides the default Gemini model.
GEMINI_MODEL=
